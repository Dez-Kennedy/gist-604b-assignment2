        <value>project_pov</value>
        <value>project_pov_fallback</value>
        <value>project_pov_function</value>
      </variableNames>
      <variableValues type="QStringList">
        <value>if( length( eval( @project_label_function ) ) &lt; 6, eval( @project_label_function ), ( if( @project_language NOT IN ('name_ar','name_bn, name_fa','name_el','name_he','name_hi','name_ja','name_ko','name_ru','name_uk','name_ur','name_zhs','name_zht'), "ABBREV", eval(@project_language))))</value>
        <value> if( eval(@project_pov_function) IN ('Admin-0 country'), coalesce( eval( @project_language ), eval( @project_language_fallback ), name ),'')</value>
        <value> coalesce( eval( @project_language ), eval( @project_language_fallback ), name )</value>
        <value> if( eval(@project_pov_function) IN ('Admin-1 scale rank'), coalesce( eval( @project_language ), eval( @project_language_fallback ), name ),'')</value>
        <value>name_en</value>
        <value>name</value>
        <value>concat( eval( @project_label_function ), if( @project_language NOT IN ('name_ar','name_bn, name_fa','name_el','name_he','name_hi','name_ja','name_ko','name_ru','name_uk','name_ur','name_zhs','name_zht'), concat('\n(',"ADM0_A3",')'), '') )</value>
        <value>if( length( @project_label_function ) &lt; 4, eval( @project_label_function ), ( if( @project_language NOT IN ('name_ar','name_bn, name_fa','name_el','name_he','name_hi','name_ja','name_ko','name_ru','name_uk','name_ur','name_zhs','name_zht'), "POSTAL", '')))</value>
        <value>fclass_us</value>
        <value>featurecla</value>
        <value> coalesce( eval( @project_pov ), eval( @project_pov_fallback ), "featurecla" )</value>
      </variableValues>
    </Variables>
