      <variableNames type="QStringList">
        <value>project_abbrev_function</value>
        <value>project_label_country_function</value>
        <value>project_label_function</value>
        <value>project_label_region_function</value>
        <value>project_language</value>
        <value>project_language_fallback</value>
        <value>project_map_subunit_function</value>
